{
  "name": "smart-library-server",
  "version": "1.0.0",
  "description": "Express + MongoDB backend for the Smart Library & Fine Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:memory": "node scripts/start-memory.js",
    "start:memory:seed": "cross-env SEED_DEMO=1 node scripts/start-memory.js",
    "seed": "node scripts/seed.js",
    "dev": "node --watch src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:unit": "cross-env NODE_ENV=test jest --runInBand --testPathPattern=tests/unit",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand --testPathPattern=tests/integration",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage"
  },
  "keywords": [
    "library",
    "express",
    "mongodb",
    "mongoose"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ],
    "verbose": true
  }
}
