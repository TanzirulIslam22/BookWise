%% UML class diagram — actual classes in the implemented codebase.
%% Singleton: DatabaseManager | Facade: BorrowFacade | Strategy: FineStrategy hierarchy
classDiagram
    class DatabaseManager {
        -static instance : DatabaseManager
        -connection
        -uri
        +static getInstance() DatabaseManager
        +connect(uri) Promise
        +disconnect() Promise
        +getState() number
    }

    class FineStrategy {
        <<abstract>>
        +calculateFine(overdueDays) number
    }

    class StudentFineStrategy {
        -perDayRate : number
        +calculateFine(overdueDays) number
    }

    class FacultyFineStrategy {
        +calculateFine(overdueDays) number
    }

    class OverdueHeavyFineStrategy {
        -baseStrategy : FineStrategy
        -threshold : number
        -heavyRate : number
        +calculateFine(overdueDays) number
    }

    class FineService {
        +getStrategyForRole(role) FineStrategy
        +computeOverdueDays(dueDate, atDate) number
        +calculateFine(role, overdueDays) number
    }

    class MemberRepository {
        +create(data)
        +findAll(options)
        +findById(id)
        +findByMemberId(memberId)
    }

    class BookRepository {
        +create(data)
        +findAll(options)
        +findById(id)
        +decrementAvailable(id)
        +incrementAvailable(id)
    }

    class BorrowRecordRepository {
        +create(data)
        +findById(id)
        +countActiveByMember(memberId) number
        +findAll(options)
        +findOverdue(now)
        +markReturned(id, returnedAt, fineAmount)
    }

    class AuditService {
        -auditEventRepository
        +record(eventType, details)
        +list(options)
    }

    class BorrowFacade {
        -memberRepository
        -bookRepository
        -borrowRecordRepository
        -fineService
        -auditService
        -loanPeriodDays
        -borrowLimits
        -now()
        +issueBook(memberId, bookId)
        +returnBook(borrowRecordId)
        +previewFine(borrowRecordId)
    }

    class Member {
        <<mongoose document>>
        +memberId : string
        +name : string
        +email : string
        +role : Student|Faculty|Librarian
    }

    class Book {
        <<mongoose document>>
        +isbn : string
        +title : string
        +author : string
        +totalCopies : number
        +availableCopies : number
    }

    class BorrowRecord {
        <<mongoose document>>
        +memberId : ObjectId
        +bookId : ObjectId
        +borrowedAt : Date
        +dueDate : Date
        +returnedAt : Date
        +status : active|returned
        +fineAmount : number
    }

    class AuditEvent {
        <<mongoose document>>
        +eventType : enum
        +memberId : ObjectId
        +borrowRecordId : ObjectId
        +message : string
    }

    FineStrategy <|-- StudentFineStrategy
    FineStrategy <|-- FacultyFineStrategy
    FineStrategy <|-- OverdueHeavyFineStrategy
    OverdueHeavyFineStrategy o-- FineStrategy : base strategy

    FineService --> FineStrategy : selects / decorates
    BorrowFacade --> MemberRepository
    BorrowFacade --> BookRepository
    BorrowFacade --> BorrowRecordRepository
    BorrowFacade --> FineService
    BorrowFacade --> AuditService
    AuditService --> AuditEventRepository
    MemberRepository --> Member : persists
    BookRepository --> Book : persists
    BorrowRecordRepository --> BorrowRecord : persists
    BorrowRecord --> Member : references (logical)
    BorrowRecord --> Book : references (logical)
    AuditEvent --> BorrowRecord : references (logical)
