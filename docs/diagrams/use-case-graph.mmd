%% Use-case view rendered as a flowchart (the official usecaseDiagram source
%% is kept in use-case.mmd for tools that support it; this file renders the
%% same information everywhere).
flowchart TB
    subgraph system["Smart Library System"]
        UC1["Register member"]
        UC2["Search members"]
        UC3["Add book to catalog"]
        UC4["Search book catalog"]
        UC5["Issue book to member"]
        UC5a["(include) Validate member and borrowing limit"]
        UC5b["(include) Check book availability"]
        UC5c["(include) Set due date + 14 days"]
        UC6["Process book return"]
        UC6a["(include) Calculate overdue fine"]
        UC6b["(include) Update book availability"]
        UC7["View overdue fines"]
        UC8["View audit history"]
        UC9["View dashboard stats"]
        UC10["View own borrowing info"]
    end

    L(("Librarian"))
    M(("Member"))

    L --> UC1
    L --> UC2
    L --> UC3
    L --> UC4
    L --> UC5
    L --> UC6
    L --> UC7
    L --> UC8
    L --> UC9
    M --> UC10

    UC5 -.-> UC5a
    UC5 -.-> UC5b
    UC5 -.-> UC5c
    UC6 -.-> UC6a
    UC6 -.-> UC6b
