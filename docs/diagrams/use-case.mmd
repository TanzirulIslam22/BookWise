%% Use-case diagram — Smart Library & Fine Management System
usecaseDiagram
    actor Librarian
    actor Member

    usecase "Register member" as UC1
    usecase "Search members" as UC2
    usecase "Add book to catalog" as UC3
    usecase "Search book catalog" as UC4
    usecase "Issue book to member" as UC5
    usecase "Validate member and borrowing limit" as UC5a
    usecase "Check book availability" as UC5b
    usecase "Set due date plus 14 days" as UC5c
    usecase "Process book return" as UC6
    usecase "Calculate overdue fine" as UC6a
    usecase "Update book availability" as UC6b
    usecase "View overdue fines" as UC7
    usecase "View audit history" as UC8
    usecase "View dashboard stats" as UC9
    usecase "View own borrowing info" as UC10

    Librarian --> UC1
    Librarian --> UC2
    Librarian --> UC3
    Librarian --> UC4
    Librarian --> UC5
    Librarian --> UC6
    Librarian --> UC7
    Librarian --> UC8
    Librarian --> UC9
    Member --> UC10

    UC5 ..> UC5a : <<include>>
    UC5 ..> UC5b : <<include>>
    UC5 ..> UC5c : <<include>>
    UC6 ..> UC6a : <<include>>
    UC6 ..> UC6b : <<include>>
