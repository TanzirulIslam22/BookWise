%% Sequence diagram — returning a book and calculating the fine.
%% Strategy pattern: FineService selects StudentFineStrategy wrapped in
%% OverdueHeavyFineStrategy, or FacultyFineStrategy (0 BDT).
sequenceDiagram
    autonumber
    actor Lib as Librarian (Browser)
    participant Ctrl as Borrowing Controller
    participant Facade as BorrowFacade
    participant RecR as BorrowRecordRepository
    participant MemR as MemberRepository
    participant BookR as BookRepository
    participant Fine as FineService
    participant Strat as FineStrategy (Student/Faculty/Heavy)
    participant Audit as AuditService
    participant DB as MongoDB

    Lib->>Ctrl: POST /api/borrowings/return/:id
    Ctrl->>Facade: returnBook(borrowRecordId)
    Facade->>RecR: findById(borrowRecordId)
    RecR->>DB: find record
    DB-->>RecR: record
    RecR-->>Facade: record
    alt record missing
        Facade-->>Ctrl: throw ApiError(404)
        Ctrl-->>Lib: 404 error
    end
    alt already returned
        Facade-->>Ctrl: throw ApiError(409, "already been returned")
        Ctrl-->>Lib: 409 error
    end

    Facade->>MemR: findById(record.memberId)
    MemR-->>Facade: member (role)
    Facade->>BookR: findById(record.bookId)
    BookR-->>Facade: book

    Facade->>Fine: computeOverdueDays(dueDate, now)
    Fine-->>Facade: overdueDays (>= 0)
    Facade->>Fine: calculateFine(member.role, overdueDays)
    Fine->>Strat: getStrategyForRole(role) then calculateFine(days)
    alt Student
        Note over Strat: OverdueHeavyFineStrategy(StudentFineStrategy(10), 7, 20)<br/>days 1-7: 10 BDT/day<br/>day 8+: first 70 BDT + 20 BDT per extra day
    else Faculty / Librarian
        Note over Strat: FacultyFineStrategy -> always 0 BDT
    end
    Strat-->>Fine: fineAmount (BDT, never negative)
    Fine-->>Facade: fineAmount

    Facade->>RecR: markReturned(id, returnedAt, fineAmount)
    RecR->>DB: update record (status: returned)
    DB-->>RecR: updated record
    RecR-->>Facade: updated record
    Facade->>BookR: incrementAvailable(bookId) (capped at totalCopies)
    BookR->>DB: update stock
    BookR-->>Facade: book

    Facade->>Audit: record(BOOK_RETURNED)
    alt overdueDays > 0
        Facade->>Audit: record(OVERDUE_DETECTED)
        Facade->>Audit: record(FINE_CALCULATED, "... X BDT ...")
    end
    Audit->>DB: insert audit events

    Facade-->>Ctrl: {message, record, overdueDays, fineAmount}
    Ctrl-->>Lib: 200 {success:true, message:"... Fine: 50 BDT"}
    Lib->>Lib: show toast with fine amount
