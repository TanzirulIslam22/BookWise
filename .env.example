# Copy this file to .env inside the server/ directory and fill in real values.
# NEVER commit a real .env file to Git.

# Port for the Express API server
PORT=5000

# MongoDB connection string.
# Local instance example:
MONGODB_URI=mongodb://127.0.0.1:27017/smart_library
# MongoDB Atlas example (replace with your own cluster string):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/smart_library?retryWrites=true&w=majority

# Loan period in days used when issuing a book
LOAN_PERIOD_DAYS=14

# Comma-separated list of allowed CORS origins for the React dev server
CLIENT_ORIGIN=http://localhost:5173

# Single-operator login gate for the web UI (POST /api/auth/login).
# CHANGE THESE before any real deployment.
ADMIN_USERNAME=librarian
ADMIN_PASSWORD=bookwise123

# Test database URI (optional).
# Leave unset to let the integration tests start an isolated in-memory MongoDB
# via mongodb-memory-server. Set it only if you want tests to use a real server.
MONGODB_URI_TEST=
